# --- Supabase (Project Settings -> API) ---
# Newer Supabase projects issue "sb_publishable_..." keys instead of the old anon JWT — use
# whichever your project shows. Both are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://ykkvqmtswfmfagrxemzh.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ScUCHHtC47eFj-KD29__Vg_UeCsd_k2

# Service-role key: SERVER-ONLY. Never prefix with NEXT_PUBLIC_. Used by staff PIN login,
# super-admin actions, and the cron route — all of which bypass RLS deliberately and do their
# own authorization checks in code.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_hYAJlwPev7p5N1jqtQFgrg_gWBaktx3

# --- Database (Project Settings -> Database -> Connection string) ---
# Only needed if/when you add Prisma or run raw migrations outside the Supabase SQL editor.
# Pooled (port 6543) for serverless/Vercel functions; direct (port 5432) for migrations.
DATABASE_URL=postgresql://postgres:sSNy8Zzw!f2iCp!@db.ykkvqmtswfmfagrxemzh.supabase.co:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:sSNy8Zzw!f2iCp!@db.ykkvqmtswfmfagrxemzh.supabase.co:5432/postgres

# --- Session signing ---
# Generate with: openssl rand -base64 48
STAFF_SESSION_SECRET=tdldIVVD7/tLbS+Pjklzgm06lsCVr7pC3KV9L7fCGfh9nad2ZrwCe362jKq2iXdk
# --- Cron ---
# Generate any random string; set the same value as a header check in Vercel Cron config.
CRON_SECRET=fEZjr04zngllxp0g1Dzm8uYicygeAHo+VleP2iFBwcFmLcR65EAS0jiPU7Pshm0X

# --- One-time bootstrap (see app/api/super-admin/bootstrap/route.ts) ---
